# Cổng nội bộ của môi trường dev (docker-compose.yml)
TENANT=tenant_bkav

# Vai trò chủ sở hữu schema — chỉ dùng để chạy migration
DATABASE_OWNER_URL=postgres://vala_owner:vala_owner@localhost:5441/vala

# Hai pool TÁCH BIỆT. Đường phục vụ báo cáo CHỈ dùng READER (không BYPASSRLS).
DATABASE_READER_URL=postgres://vala_reader:vala_reader@localhost:5441/vala
DATABASE_WRITER_URL=postgres://vala_writer:vala_writer@localhost:5441/vala

REDIS_URL=redis://localhost:6391

# Vault: "vault" (HashiCorp KV v2) hoặc "memory" (chỉ cho test)
SECRET_STORE=vault
VAULT_ADDR=http://localhost:8201
# Token ứng dụng: Vault (infra/vault/entrypoint.sh) tự tạo token này với quyền chỉ trong secret/* — đặt chuỗi ngẫu nhiên dài.
VAULT_TOKEN=dev-root-token
VAULT_KV_MOUNT=secret

# Đăng nhập cổng bằng tài khoản/mật khẩu luôn bật. Đặt LOGIN_SSO=true để bật thêm đăng nhập qua Bkav SSO.
LOGIN_SSO=false
AUTH_JWT_SECRET=change-me-dev-only

# Bkav SSO / IAM (chỉ dùng khi LOGIN_SSO=true hoặc có kết nối auth_method=sso).
# Production: iam.bkav.com, client do đội SSO cấp;
# redirect URI cần đăng ký: {PUBLIC_API_URL}/api/v1/sso/callback
SSO_ORIGIN=http://localhost:4020
SSO_CLIENT_ID=vala-reporting
SSO_CLIENT_SECRET=dev-secret
# Mặc định theo WSO2: {SSO_ORIGIN}/oauth2/authorize|token|userinfo|revoke. Ghi đè bằng SSO_AUTHORIZE_URL,…

# Base URL hệ thống nguồn: đặt <NGUON>_BASE_URL để ghi đè core.source_systems.base_url (vd trỏ mock khi test).
# Không ghi đè ⇒ dùng base_url quản trị cấu hình trên giao diện cho từng hệ thống nguồn.

# Crawlab — nơi quản trị quản lý script Python crawl và lịch chạy (docker compose up -d crawlab).
CRAWLAB_URL=http://localhost:8080
CRAWLAB_USERNAME=admin
CRAWLAB_PASSWORD=admin
# Địa chỉ API mà spider trong Crawlab gọi tới (Crawlab dev chạy mạng host nên localhost dùng được).
SPIDER_API_URL=http://localhost:3000

# Token cho Crawlab gọi /internal/*
INTERNAL_TOKEN=change-me-internal

# Docker Compose — máy dev: COMPOSE_PROFILES=dev ⇒ `docker compose up -d` bật tất cả (kèm api/worker/web dev);
# không đặt RESTART_POLICY ⇒ tắt máy là tắt, không tự lên lại.
# Máy chủ chính thức: COMPOSE_PROFILES=full và RESTART_POLICY=unless-stopped (tự lên lại sau khi khởi động máy).
# COMPOSE_PROFILES=dev
# RESTART_POLICY=unless-stopped

# Worker làm mới phiên ứng dụng sắp hết hạn trong vòng chừng này phút (chạy mỗi 10 phút)
SESSION_REFRESH_WITHIN_MINUTES=60

API_PORT=3000
PUBLIC_WEB_URL=http://localhost:5173
