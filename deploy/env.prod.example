# =====================================================================
# .env.prod — cấu hình máy chủ chạy thật. TẠO bằng `deploy/gen-env.sh <địa chỉ web>` (sinh sẵn mật khẩu/khoá ngẫu nhiên),
# KHÔNG commit file này. Các giá trị <…> gen-env.sh tự điền.
# =====================================================================

# Địa chỉ người dùng mở cổng (và nhập vào tiện ích trình duyệt). Có HTTPS thì dùng https://…
PUBLIC_WEB_URL=http://10.2.65.146
PUBLIC_API_URL=http://10.2.65.146
HTTP_PORT=80
HTTPS_PORT=443

TENANT=tenant_bkav

# CSDL — mật khẩu riêng cho 3 vai trò (owner: migration; reader: đọc có RLS; writer: worker/quản trị)
POSTGRES_PASSWORD=<ngẫu nhiên>
DB_READER_PASSWORD=<ngẫu nhiên>
DB_WRITER_PASSWORD=<ngẫu nhiên>

# Ký token đăng nhập cổng; token nội bộ cho spider (Crawlab) gọi API; token ứng dụng của Vault.
AUTH_JWT_SECRET=<ngẫu nhiên>
INTERNAL_TOKEN=<ngẫu nhiên>
VAULT_TOKEN=<ngẫu nhiên>
VAULT_KV_MOUNT=secret

# Crawlab: tài khoản quản trị Crawlab (mặc định admin/admin — ĐỔI trong giao diện Crawlab rồi sửa ở đây).
CRAWLAB_USERNAME=admin
CRAWLAB_PASSWORD=admin
CRAWLAB_PORT=8080
# Link "Mở Crawlab" trên trang Script crawl (Crawlab chỉ mở ở 127.0.0.1 — xem qua SSH tunnel).
CRAWLAB_WEB_URL=http://127.0.0.1:8080
# Spider gọi hệ thống nguồn qua proxy công ty? (máy dev dùng http://proxybsh.bkav.com:3128). Bỏ trống = gọi thẳng.
SOURCE_HTTP_PROXY=

# Đăng nhập cổng: mật khẩu (luôn bật). Bkav SSO: chỉ bật khi đã đăng ký client với iam.bkav.com.
LOGIN_SSO=false
SSO_ORIGIN=https://iam.bkav.com
SSO_CLIENT_ID=vala-reporting
SSO_CLIENT_SECRET=chua-dang-ky

# Tinh chỉnh (giữ mặc định nếu không chắc)
SESSION_REFRESH_WITHIN_MINUTES=60
CRAWL_CONCURRENCY=5
MAX_SUBSCRIPTIONS_PER_USER=10
