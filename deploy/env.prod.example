# =====================================================================
# .env.prod — cấu hình máy chủ chạy thật. TẠO bằng `deploy/gen-env.sh <địa chỉ web>` (sinh sẵn mật khẩu/khoá ngẫu nhiên),
# KHÔNG commit file này. Các giá trị <…> gen-env.sh tự điền.
# =====================================================================

# Địa chỉ người dùng mở cổng (và nhập vào tiện ích trình duyệt). Có HTTPS thì dùng https://…
PUBLIC_WEB_URL=http://10.2.65.146
PUBLIC_API_URL=http://10.2.65.146
HTTP_PORT=80
HTTPS_PORT=443
# k3s: cách mở web ra ngoài — hostport (pod web giữ cổng 5443, chứng chỉ ở deploy/certs) hoặc istio (sau Istio ingress
# gateway có sẵn; PUBLIC_WEB_URL được có đường dẫn con, vd https://qtttboard-demo.demozone.vn:5443/vala-report).
WEB_EXPOSE=hostport

# Tên schema dữ liệu trong CSDL — tên NỘI BỘ (người dùng không thấy), các migration đang dùng đúng tên này: GIỮ NGUYÊN.
# Tên đơn vị, logo, màu, tên SSO hiển thị: đặt trên cổng ở Quản trị → Cấu hình chung.
TENANT=tenant_bkav

# CSDL — mật khẩu riêng cho 3 vai trò (owner: migration; reader: đọc có RLS; writer: worker/quản trị)
POSTGRES_PASSWORD=<ngẫu nhiên>
DB_READER_PASSWORD=<ngẫu nhiên>
DB_WRITER_PASSWORD=<ngẫu nhiên>

# Ký token đăng nhập cổng; token nội bộ cho spider (Crawlab) gọi API; token ứng dụng của Vault.
AUTH_JWT_SECRET=<ngẫu nhiên>
INTERNAL_TOKEN=<ngẫu nhiên>
VAULT_TOKEN=<ngẫu nhiên>
VAULT_KV_MOUNT=secret

# Crawlab: tài khoản quản trị Crawlab (mặc định admin/admin — ĐỔI trong giao diện Crawlab rồi sửa ở đây).
CRAWLAB_USERNAME=admin
CRAWLAB_PASSWORD=admin
CRAWLAB_PORT=8080
# Link "Mở Crawlab" trên trang Script crawl — địa chỉ người dùng mở từ trình duyệt (k3s: IP LAN của máy chủ, xem crawlab.yaml).
CRAWLAB_WEB_URL=http://127.0.0.1:8080
# Spider gọi hệ thống nguồn qua proxy của đơn vị? (vd http://proxy.ten-don-vi.vn:3128). Bỏ trống = gọi thẳng.
SOURCE_HTTP_PROXY=

# Đăng nhập cổng: mật khẩu (luôn bật). Thêm SSO của nơi triển khai — bất kỳ SSO chuẩn OIDC (Keycloak, SSO tỉnh, WSO2
# như Bkav SSO, Azure AD…), KHÔNG phải cài thêm gì: nhờ quản trị SSO đăng ký Vala làm một client
#   - loại: confidential, luồng authorization code (có PKCE càng tốt)
#   - redirect URI: {PUBLIC_API_URL}/api/v1/sso/callback
# rồi điền dưới đây. Tên hiển thị của SSO đặt ở Quản trị → Cấu hình chung.
LOGIN_SSO=false
# Cách 1 (khuyên dùng): issuer OIDC — tự đọc các endpoint, vd Keycloak https://sso.tinh.gov.vn/realms/cong-chuc
SSO_ISSUER=
# Cách 2: SSO kiểu WSO2 không bật discovery — gốc SSO, dùng đường dẫn /oauth2/* (vd https://iam.bkav.com).
SSO_ORIGIN=
SSO_CLIENT_ID=vala-reporting
SSO_CLIENT_SECRET=chua-dang-ky
# Lần đầu đăng nhập SSO ghép với tài khoản cổng có sẵn theo: email, rồi tên đăng nhập (claim preferred_username).
SSO_MATCH_BY=email,username
# Chưa có tài khoản cổng ⇒ tự tạo (người dùng thường)? Mặc định không: quản trị tạo người dùng trước.
SSO_AUTO_CREATE=false
# SSO không trả email (vd Bkav SSO chưa cấu hình claim email) ⇒ ghép <tên đăng nhập>@miền này để ghép / tạo tài khoản.
# Chỉ đặt khi tên đăng nhập SSO đúng là phần trước @ của email nội bộ. Trống ⇒ không ghép.
SSO_EMAIL_DOMAIN=
# PKCE (S256) cho luồng đăng nhập — tắt chỉ khi SSO không hỗ trợ.
SSO_PKCE=true

# Tinh chỉnh (giữ mặc định nếu không chắc)
# Giữ phiên (T10): mỗi bao nhiêu phút gọi nhẹ hệ thống nguồn bằng phiên do Vala Desktop gửi để phiên không hết hạn vì để
# lâu không dùng (0 = tắt). Mặc định 10.
SESSION_KEEPALIVE_MINUTES=10
SESSION_REFRESH_WITHIN_MINUTES=60
CRAWL_CONCURRENCY=5
MAX_SUBSCRIPTIONS_PER_USER=10

# Khoá ký gói kịch bản Vala Desktop (32 byte, base64: openssl rand -base64 32). Trống ⇒ suy ra từ AUTH_JWT_SECRET.
# Đổi khoá không cần làm gì thêm: ứng dụng nhận khoá mới cùng lần tải gói kế tiếp. Xem docs/kich-ban-desktop.md.
SCRIPT_SIGNING_KEY=
